# ==============================================================================
# Silicon Mango Academy Production Environment Variables Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to a new file named `.env` in the same directory:
#    cp .env.example .env
# 2. Modify the variables below to match your server configuration and credentials.
# 3. Ensure you generate a secure SECRET_KEY for production.
# ==============================================================================

# ------------------------------------------------------------------------------
# Server Ports & External Access
# ------------------------------------------------------------------------------
# The host port where the Nginx web server will be exposed.
# Default is 8085, which does not conflict with your other services (8081, 5678, 3000, 11434, 5000, 800, 8080, 9000).
# Point your Cloudflare Tunnel hostname (e.g. academy.siliconmango.in) to http://localhost:8085
FRONTEND_PORT=8085

# ------------------------------------------------------------------------------
# PostgreSQL Database Credentials
# ------------------------------------------------------------------------------
# Note: These values are used to configure the internal Postgres container database.
# The backend container connects internally via the service name `postgres`.
POSTGRES_DB=silicon_academy
POSTGRES_USER=postgres
# WARNING: Change this password to a secure random string in production!
POSTGRES_PASSWORD=postgres

# ------------------------------------------------------------------------------
# FastAPI Backend Configuration
# ------------------------------------------------------------------------------
# Set to 'false' in production to disable verbose debugging endpoints and tracebacks
DEBUG=false

# WARNING: Create a long, secure random string for JWT token signatures!
# E.g. generate one using: openssl rand -hex 32
SECRET_KEY=replace-this-for-production-very-secure-key-123

# Allow request origins. Set to * for convenience, or restrict to your actual public domains
# E.g., http://localhost:8085,https://academy.siliconmango.in
ALLOWED_ORIGINS=*

# Token expiration time in minutes (default is 8 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ------------------------------------------------------------------------------
# Master User Seed Credentials
# ------------------------------------------------------------------------------
# These credentials will be automatically populated into the database on the very first boot.
# You can use them to log into the admin portal right away.
MASTER_ADMIN_NAME=Master Admin
MASTER_ADMIN_EMAIL=admin@siliconmango.academy
# WARNING: Change this to a secure password!
MASTER_ADMIN_PASSWORD=Admin@123
DEFAULT_INSTRUCTOR_PASSWORD=Instructor@123

# ------------------------------------------------------------------------------
# Razorpay Payment Gateway (Optional)
# ------------------------------------------------------------------------------
# 'test' for sandbox mode, 'live' for real payments
RAZORPAY_MODE=test
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
RAZORPAY_LIVE_KEY_ID=
RAZORPAY_LIVE_KEY_SECRET=

# ------------------------------------------------------------------------------
# SMTP Email Setup (Optional)
# ------------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
